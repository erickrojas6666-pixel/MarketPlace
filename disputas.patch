+          <button
+            v-if="sinTomar"
+            type="button"
+            :disabled="tomando"
+            @click="tomar"
+            class="px-4 py-2 rounded-xl text-sm font-bold bg-niebla text-principal border border-principal/20 hover:bg-principal/10 disabled:opacity-50"
+          >
+            Tomar el caso
+          </button>
+        </div>
+
+        <fieldset class="space-y-2">
